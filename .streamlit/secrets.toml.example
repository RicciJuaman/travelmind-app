# Copy this file to .streamlit/secrets.toml and fill in your values
# DO NOT commit secrets.toml to GitHub — add it to .gitignore

AWS_ACCESS_KEY_ID     = "YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_AWS_SECRET_ACCESS_KEY"
AWS_REGION            = "us-west-2"

BEDROCK_AGENT_ID       = "HSC0WCWRGW"        # Your Supervisor agent ID
BEDROCK_AGENT_ALIAS_ID = "YOUR_ALIAS_ID"     # The v1 alias ID (not TSTALIASID)
